---
import type { Deck } from "../decks";

interface Props {
	deck: Deck;
}
const { deck } = Astro.props;
---

<div class="viewer" data-viewer data-pdf={`/pdf/${deck.slug}.pdf`} data-pages={deck.pages} style={`--aspect:${deck.aspect}`}>
	<div class="stage" data-stage>
		<img class="placeholder" src={`/thumbs/${deck.slug}.png`} alt={deck.title} data-placeholder />
	</div>
	<div class="controls">
		<button type="button" data-prev aria-label="前へ">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
		</button>
		<span class="counter"><span data-current>1</span> / {deck.pages}</span>
		<button type="button" data-next aria-label="次へ">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
		</button>
		<button type="button" data-fullscreen aria-label="全画面" class="fs">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
		</button>
	</div>
</div>

<script>
	import { GlobalWorkerOptions, getDocument } from "pdfjs-dist/legacy/build/pdf.mjs";
	import workerSrc from "pdfjs-dist/legacy/build/pdf.worker.min.mjs?url";

	GlobalWorkerOptions.workerSrc = workerSrc;

	const root = document.querySelector<HTMLElement>("[data-viewer]")!;
	const stage = root.querySelector<HTMLElement>("[data-stage]")!;
	const placeholder = root.querySelector<HTMLImageElement>("[data-placeholder]")!;
	const currentEl = root.querySelector<HTMLElement>("[data-current]")!;
	const total = Number(root.dataset.pages);

	const ready = getDocument({
		url: root.dataset.pdf!,
		cMapUrl: "/pdfjs/cmaps/",
		cMapPacked: true,
		standardFontDataUrl: "/pdfjs/standard_fonts/",
		isEvalSupported: false,
	}).promise;

	let current = 1;
	let token = 0;
	let shown: HTMLCanvasElement | null = null;

	async function show(n: number) {
		current = Math.min(Math.max(n, 1), total);
		currentEl.textContent = String(current);
		const my = ++token;

		const page = await (await ready).getPage(current);
		const base = page.getViewport({ scale: 1 });
		const fitW = Math.min(stage.clientWidth, stage.clientHeight * (base.width / base.height));
		const viewport = page.getViewport({ scale: (fitW * devicePixelRatio) / base.width });
		const canvas = document.createElement("canvas");
		canvas.width = Math.floor(viewport.width);
		canvas.height = Math.floor(viewport.height);
		canvas.style.width = `${Math.floor(fitW)}px`;
		await page.render({ canvas, viewport }).promise;

		if (my !== token) return;
		shown?.remove();
		stage.prepend(canvas);
		shown = canvas;
		placeholder.hidden = true;
	}

	root.querySelector("[data-prev]")!.addEventListener("click", () => show(current - 1));
	root.querySelector("[data-next]")!.addEventListener("click", () => show(current + 1));
	stage.addEventListener("click", (e) => {
		const rect = stage.getBoundingClientRect();
		show(current + (e.clientX - rect.left < rect.width / 3 ? -1 : 1));
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "ArrowRight") show(current + 1);
		else if (e.key === "ArrowLeft") show(current - 1);
	});
	root.querySelector("[data-fullscreen]")!.addEventListener("click", () => {
		if (document.fullscreenElement) document.exitFullscreen();
		else root.requestFullscreen?.();
	});

	let resizeTimer: ReturnType<typeof setTimeout>;
	new ResizeObserver(() => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(() => show(current), 120);
	}).observe(stage);
</script>
