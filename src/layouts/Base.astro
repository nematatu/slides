---
import "../styles.css";

interface Props {
	title?: string;
	image?: string;
}
const { title, image } = Astro.props;
const fullTitle = title ? `${title} | amatatu slides` : "amatatu slides";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.ico" />
		<meta property="og:title" content={title ?? "amatatu slides"} />
		{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
		{image && <meta name="twitter:card" content="summary_large_image" />}
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand">amatatu <span>slides</span></a>
		</header>
		<slot />
	</body>
</html>
