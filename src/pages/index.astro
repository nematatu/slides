---
import Base from "../layouts/Base.astro";
import { allDecks, formatDate } from "../decks";
---

<Base>
	<main class="container">
		<ul class="grid">
			{
				allDecks.map((d) => (
					<li>
						<a href={`/${d.slug}/`} class="card">
							<img src={`/thumbs/${d.slug}.png`} alt="" loading="lazy" style={`aspect-ratio:${d.aspect}`} />
							<h2>{d.title}</h2>
							<p class="meta">
								{d.date && <time datetime={d.date}>{formatDate(d.date)}</time>}
								{d.event && <span>{d.event}</span>}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Base>
