---
import Base from "../layouts/Base.astro";
import Viewer from "../components/Viewer.astro";
import { allDecks, formatDate, type Deck } from "../decks";

export function getStaticPaths() {
	return allDecks.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }));
}
const { deck } = Astro.props as { deck: Deck };
---

<Base title={deck.title} image={`/thumbs/${deck.slug}.png`}>
	<main class="container narrow">
		<Viewer deck={deck} />
		<h1 class="deck-title">{deck.title}</h1>
		<p class="meta">
			{deck.date && <time datetime={deck.date}>{formatDate(deck.date)}</time>}
			{deck.event && <span>{deck.event}</span>}
			<a href={`/pdf/${deck.slug}.pdf`} download>PDF</a>
		</p>
	</main>
</Base>
